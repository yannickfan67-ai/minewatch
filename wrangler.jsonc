{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minewatch-p2p",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minewatch-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMERA_ROOMS",
        "class_name": "CameraRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CameraRoom"]
    }
  ]
}
